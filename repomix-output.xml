                      </TableCell>
                      <TableCell>{link.clicks || 0}</TableCell>
                      <TableCell>{link.conversions || 0}</TableCell>
                      <TableCell>{formatNGN(link.revenue)}</TableCell>
                      <TableCell className="text-green-600 font-semibold">
                        {formatNGN(link.commission_earned)}
