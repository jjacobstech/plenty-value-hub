@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Manrope:wght@300;400;500;600;700;800&display=swap');

@import "tailwindcss";

/* ───────────────────────────────────────────────
   Tailwind v4 theme — maps CSS vars to utilities
   ─────────────────────────────────────────────── */
@theme {
  /* Fonts */
  --font-body: 'Manrope', sans-serif;
  --font-heading: 'Inter', sans-serif;
  --font-display: 'Inter', sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  /* Colors — resolved from CSS custom properties set in :root */
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-success: hsl(var(--success));
  --color-success-foreground: hsl(var(--success-foreground));

  /* Chart colors */
  --color-chart-1: hsl(var(--chart-1));
  --color-chart-2: hsl(var(--chart-2));
  --color-chart-3: hsl(var(--chart-3));
  --color-chart-4: hsl(var(--chart-4));
  --color-chart-5: hsl(var(--chart-5));

  /* Sidebar colors */
  --color-sidebar: hsl(var(--sidebar-background));
  --color-sidebar-foreground: hsl(var(--sidebar-foreground));
  --color-sidebar-primary: hsl(var(--sidebar-primary));
  --color-sidebar-primary-foreground: hsl(var(--sidebar-primary-foreground));
  --color-sidebar-accent: hsl(var(--sidebar-accent));
  --color-sidebar-accent-foreground: hsl(var(--sidebar-accent-foreground));
  --color-sidebar-border: hsl(var(--sidebar-border));
  --color-sidebar-ring: hsl(var(--sidebar-ring));

  /* Explicit brand shortcuts */
  --color-brand-navy: #001845;
  --color-brand-green: #81C14B;
  --color-brand-purple: #715AFF;
  --color-brand-orange: #F4A300;

  /* Border radius */
  --radius-lg: var(--radius);
  --radius-md: calc(var(--radius) - 2px);
  --radius-sm: calc(var(--radius) - 4px);

  /* Accordion animations */
  --animate-accordion-down: accordion-down 0.2s ease-out;
  --animate-accordion-up: accordion-up 0.2s ease-out;

  @keyframes accordion-down {
    from { height: 0 }
    to { height: var(--radix-accordion-content-height) }
  }
  @keyframes accordion-up {
    from { height: var(--radix-accordion-content-height) }
    to { height: 0 }
  }
}

/* ───────────────────────────────────────────────
   CSS custom properties (shadcn/radix use these)
   ─────────────────────────────────────────────── */
@layer base {
  :root {
    /* Navy Blue #001845 → hsl(220, 100%, 13%) */
    /* Green #81C14B   → hsl(92, 47%, 52%)    */
    /* Purple #715AFF  → hsl(250, 100%, 67%)  */
    /* Orange #F4A300  → hsl(40, 100%, 48%)   */

    --background: 220 30% 97%;
    --foreground: 220 100% 13%;
    --card: 0 0% 100%;
    --card-foreground: 220 100% 13%;
    --popover: 0 0% 100%;
    --popover-foreground: 220 100% 13%;

    /* Primary = Green #81C14B */
    --primary: 92 47% 52%;
    --primary-foreground: 0 0% 100%;

    /* Secondary = Navy Blue #001845 */
    --secondary: 220 100% 13%;
    --secondary-foreground: 0 0% 100%;

    --muted: 220 20% 95%;
    --muted-foreground: 220 15% 45%;

    --accent: 92 47% 92%;
    --accent-foreground: 92 47% 30%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;

    --border: 220 20% 88%;
    --input: 220 20% 88%;
    --ring: 92 47% 52%;

    --success: 92 47% 40%;
    --success-foreground: 0 0% 100%;

    --chart-1: 92 47% 52%;
    --chart-2: 220 100% 13%;
    --chart-3: 250 100% 67%;
    --chart-4: 220 60% 40%;
    --chart-5: 0 84% 60%;

    --radius: 0.625rem;

    --sidebar-background: 220 100% 9%;
    --sidebar-foreground: 220 20% 90%;
    --sidebar-primary: 92 47% 52%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 220 100% 15%;
    --sidebar-accent-foreground: 220 20% 90%;
    --sidebar-border: 220 60% 18%;
    --sidebar-ring: 92 47% 52%;
  }

  .dark {
    --background: 220 100% 7%;
    --foreground: 220 20% 95%;
    --card: 220 100% 10%;
    --card-foreground: 220 20% 95%;
    --popover: 220 100% 10%;
    --popover-foreground: 220 20% 95%;
    --primary: 40 100% 48%;
    --primary-foreground: 0 0% 100%;
    --secondary: 220 20% 90%;
    --secondary-foreground: 220 100% 13%;
    --muted: 220 60% 16%;
    --muted-foreground: 220 20% 55%;
    --accent: 92 47% 15%;
    --accent-foreground: 92 47% 65%;
    --destructive: 0 62% 30%;
    --destructive-foreground: 0 0% 98%;
    --border: 220 60% 18%;
    --input: 220 60% 18%;
    --ring: 220 100% 13%;
    --chart-1: 220 100% 20%;
    --chart-2: 92 47% 58%;
    --chart-3: 250 100% 72%;
    --chart-4: 220 60% 50%;
    --chart-5: 0 84% 65%;
    --sidebar-background: 220 100% 6%;
    --sidebar-foreground: 220 20% 88%;
    --sidebar-primary: 92 47% 52%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 220 100% 12%;
    --sidebar-accent-foreground: 220 20% 88%;
    --sidebar-border: 220 60% 15%;
    --sidebar-ring: 92 47% 52%;
  }

  [x-cloak] {
    display: none;
  }

  * {
    @apply border-border outline-ring/50;
  }

  body {
    @apply bg-background text-foreground font-body;
  }
}
