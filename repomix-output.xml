@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Manrope:wght@300;400;500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Navy Blue #001845 → hsl(220, 100%, 13%) */
    /* Green #81C14B → hsl(92, 47%, 52%) */
    /* Purple #715AFF → hsl(250, 100%, 67%) */
    /* Orange #F4A300 → hsl(40, 100%, 48%) */

    --background: 220 30% 97%;
    --foreground: 220 100% 13%;
    --card: 0 0% 100%;
    --card-foreground: 220 100% 13%;
    --popover: 0 0% 100%;
    --popover-foreground: 220 100% 13%;

