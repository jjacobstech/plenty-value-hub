    productMap[key].revenue += o.vendor_payout || 0;
  });
  const topProducts = Object.values(productMap).sort((a, b) => b.revenue - a.revenue).slice(0, 5);

  const statusColors = {
    completed: 'bg-green-100 text-green-700',
