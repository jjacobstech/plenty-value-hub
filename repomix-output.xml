const STATUS_COLORS = { draft: 'bg-yellow-100 text-yellow-700', published: 'bg-green-100 text-green-700', archived: 'bg-gray-100 text-gray-500' };
const QUILL_MODULES = { toolbar: [['bold', 'italic', 'underline'], [{ header: [1, 2, 3, false] }], [{ list: 'ordered' }, { list: 'bullet' }], ['link', 'image'], ['blockquote'], ['clean']] };
const QUILL_FORMATS = ['bold', 'italic', 'underline', 'header', 'list', 'bullet', 'link', 'image', 'blockquote'];

const EMPTY = { title: '', slug: '', excerpt: '', content: '', featured_image_url: '', category: '', tags: [], author_name: '', status: 'draft', seo_title: '', seo_description: '' };

