    const dayStr = format(day, 'MMM d');
    const dayRevenue = completedOrders
      .filter(o => format(new Date(o.created_date), 'MMM d') === dayStr)
      .reduce((sum, o) => sum + (o.vendor_payout || 0), 0);
    return { day: dayStr, revenue: dayRevenue };
  });

  // Product performance
