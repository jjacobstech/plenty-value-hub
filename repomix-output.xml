          ) : reviews.length > 0 ? (
            reviews.map(review => (
              <Card key={review.id} className="hover:shadow-md transition-all duration-200 hover:border-[#81C14B]/30">
                <CardContent className="p-6">
                  <div className="flex items-start justify-between mb-3">
