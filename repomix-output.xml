  const totalEarnings = orders.filter(o => o.status === 'completed').reduce((sum, o) => sum + (o.commission_amount || 0), 0);
  const pendingEarnings = orders.filter(o => o.status === 'pending').reduce((sum, o) => sum + (o.commission_amount || 0), 0);
