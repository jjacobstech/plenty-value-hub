                  <div className="flex items-center gap-4 flex-1 min-w-0">
                    <div className="w-16 h-16 rounded-xl bg-muted shrink-0 overflow-hidden border">
                      {product.imageUrl && /^https?:\/\//.test(product.imageUrl) ? (
