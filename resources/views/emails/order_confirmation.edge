<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Confirmation - Plenty Value</title>
    <style>
      body {
        font-family:
          Segoe UI,
          Arial,
          sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: #001845;
        color: white;
        padding: 40px 20px;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        font-size: 28px;
      }
      .content {
        padding: 40px;
        color: #333;
      }
      .content p {
        margin: 0 0 20px 0;
        line-height: 1.6;
      }
      .order-details {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 4px;
        margin: 20px 0;
      }
      .detail-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
      }
      .footer {
        background: #f9f9f9;
        padding: 20px;
        text-align: center;
        color: #666;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Plenty Value</h1>
      </div>
      <div class="content">
        <p>Thank you for your purchase!</p>
        <p>Your order has been confirmed. Here are the details:</p>
        <div class="order-details">
          <div class="detail-row">
            <strong>Order Number:</strong>
            <span>{{ order.orderNumber }}</span>
          </div>
          <div class="detail-row">
            <strong>Product:</strong>
            <span>{{ order.productName }}</span>
          </div>
          <div class="detail-row"><strong>Amount:</strong> <span>{{ currencySymbol || '$' }}{{ order.amount }}</span></div>
          <div class="detail-row"><strong>Status:</strong> <span>{{ order.status }}</span></div>
        </div>

        @if(digitalAsset)
          <div class="order-details" style="background: #f0fdf4; border: 2px solid #81C14B; border-radius: 8px; padding: 24px; text-align: center; margin: 30px 0;">
            <div style="background: #81C14B; color: white; padding: 8px 16px; border-radius: 20px; display: inline-block; font-size: 12px; font-weight: bold; margin-bottom: 16px;">
              📥 DIGITAL DOWNLOAD READY
            </div>
            <h3 style="margin: 0 0 12px 0; color: #15803d; font-size: 20px;">Your Digital Product Is Ready!</h3>
            <p style="margin: 0 0 20px 0; color: #166534; font-size: 16px;">
              <strong>{{ digitalAsset.name }}</strong> can be downloaded immediately using the button below:
            </p>
            <a href="{{ digitalAsset.url }}" target="_blank" rel="noopener" style="display: inline-block; background: #81C14B; color: white; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; box-shadow: 0 2px 4px rgba(129, 193, 75, 0.3);">
              🔽 Download Now
            </a>
            <p style="margin: 16px 0 0 0; font-size: 12px; color: #16a34a;">
              This link will remain active. You can also access it anytime through your order tracking page.
            </p>
          </div>
        @end

        @if(trackOrderUrl)
          <div style="margin: 20px 0; text-align: center;">
            <a href="{{ trackOrderUrl }}" target="_blank" style="display: inline-block; background: #001845; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-size: 14px;">Track Order & View Downloads</a>
          </div>
        @end

        @if(vendor)
          <div class="order-details" style="background: #e0f2fe; border-left: 4px solid #0284c7;">
            <p style="margin-top: 0; font-weight: 600; color: #0c4a6e;">Seller Information</p>
            @if(vendor.businessName)
              <div class="detail-row">
                <strong>Business:</strong>
                <span>{{ vendor.businessName }}</span>
              </div>
            @end
            @if(vendor.email)
              <div class="detail-row">
                <strong>Email:</strong>
                <span><a href="mailto:{{ vendor.email }}" style="color: #0284c7; text-decoration: none;">{{ vendor.email }}</a></span>
              </div>
            @end
            @if(vendor.phone)
              <div class="detail-row">
                <strong>Phone:</strong>
                <span><a href="tel:{{ vendor.phone }}" style="color: #0284c7; text-decoration: none;">{{ vendor.phone }}</a></span>
              </div>
            @end
            @if(vendor.location)
              <div class="detail-row">
                <strong>Location:</strong>
                <span>{{ vendor.location }}</span>
              </div>
            @end
          </div>
        @end

        @if(isManualPayment)
          <div class="order-details" style="background: #fffbeb; border-left: 4px solid #f59e0b;">
            <p><strong>Manual payment instructions</strong></p>
            <p>Send your payment via: <strong>{{ manualInstructions.payoutMethod }}</strong></p>
            <p><strong>Account details:</strong> {{ manualInstructions.payoutDetails }}</p>
            <p>
              Once you have made the transfer, please notify the seller using the order details or by emailing them directly.
            </p>
          </div>
        @end

        <p>We appreciate your business and hope you enjoy your purchase!</p>
      </div>
      <div class="footer">
        <p>&copy; 2026 Plenty Value. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
