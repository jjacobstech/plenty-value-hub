<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Processing - Plenty Value</title>
    <style>
      body {
        font-family:
          Segoe UI,
          Arial,
          sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: #001845;
        color: white;
        padding: 40px 20px;
        text-align: center;
      }
      .header h1 {
        margin: 0;
        font-size: 28px;
      }
      .content {
        padding: 40px;
        color: #333;
      }
      .content p {
        margin: 0 0 20px 0;
        line-height: 1.6;
      }
      .order-details {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 4px;
        margin: 20px 0;
      }
      .detail-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
      }
      .processing-notice {
        background: #fffbeb;
        border: 2px solid #f59e0b;
        border-radius: 8px;
        padding: 24px;
        text-align: center;
        margin: 30px 0;
      }
      .footer {
        background: #f9f9f9;
        padding: 20px;
        text-align: center;
        color: #666;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Plenty Value</h1>
      </div>
      <div class="content">
        <p>Thank you for your purchase!</p>
        <p>Your order has been received and is now being processed. Here are the details:</p>
        
        <div class="order-details">
          <div class="detail-row">
            <strong>Order Number:</strong>
            <span>{{ order.orderNumber }}</span>
          </div>
          <div class="detail-row">
            <strong>Product:</strong>
            <span>{{ order.productName }}</span>
          </div>
          <div class="detail-row"><strong>Amount:</strong> <span>${{ order.amount }}</span></div>
          <div class="detail-row"><strong>Status:</strong> <span>Processing</span></div>
        </div>

        <div class="processing-notice">
          <div style="background: #f59e0b; color: white; padding: 8px 16px; border-radius: 20px; display: inline-block; font-size: 12px; font-weight: bold; margin-bottom: 16px;">
            📦 ORDER PROCESSING
          </div>
          <h3 style="margin: 0 0 12px 0; color: #d97706; font-size: 20px;">Your Order is Being Prepared!</h3>
          <p style="margin: 0 0 20px 0; color: #92400e; font-size: 16px;">
            The seller is now preparing your order for shipment. You will receive another email with tracking information once your order has been shipped.
          </p>
          @if(trackOrderUrl)
            <a href="{{ trackOrderUrl }}" target="_blank" rel="noopener" style="display: inline-block; background: #001845; color: white; padding: 12px 24px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px;">
              Track Order Status
            </a>
          @end
        </div>

        @if(shippingDetails)
          <div class="order-details" style="background: #f0f9ff; border-left: 4px solid #0284c7;">
            <p style="margin-top: 0; font-weight: 600; color: #0c4a6e;">Shipping Address</p>
            @if(shippingDetails.fullName)
              <div class="detail-row">
                <strong>Name:</strong>
                <span>{{ shippingDetails.fullName }}</span>
              </div>
            @end
            @if(shippingDetails.phone)
              <div class="detail-row">
                <strong>Phone:</strong>
                <span>{{ shippingDetails.phone }}</span>
              </div>
            @end
            @if(shippingDetails.address)
              <div class="detail-row">
                <strong>Address:</strong>
                <span>{{ shippingDetails.address }}</span>
              </div>
            @end
            @if(shippingDetails.city || shippingDetails.state || shippingDetails.country)
              <div class="detail-row">
                <strong>Location:</strong>
                <span>{{ [shippingDetails.city, shippingDetails.state, shippingDetails.country] | join(', ') }}</span>
              </div>
            @end
          </div>
        @end

        @if(vendor)
          <div class="order-details" style="background: #e0f2fe; border-left: 4px solid #0284c7;">
            <p style="margin-top: 0; font-weight: 600; color: #0c4a6e;">Seller Information</p>
            @if(vendor.businessName)
              <div class="detail-row">
                <strong>Business:</strong>
                <span>{{ vendor.businessName }}</span>
              </div>
            @end
            @if(vendor.email)
              <div class="detail-row">
                <strong>Email:</strong>
                <span><a href="mailto:{{ vendor.email }}" style="color: #0284c7; text-decoration: none;">{{ vendor.email }}</a></span>
              </div>
            @end
            @if(vendor.phone)
              <div class="detail-row">
                <strong>Phone:</strong>
                <span><a href="tel:{{ vendor.phone }}" style="color: #0284c7; text-decoration: none;">{{ vendor.phone }}</a></span>
              </div>
            @end
            @if(vendor.location)
              <div class="detail-row">
                <strong>Location:</strong>
                <span>{{ vendor.location }}</span>
              </div>
            @end
          </div>
        @end

        <p>We appreciate your business and will keep you updated on your order progress!</p>
        <p><strong>What happens next?</strong></p>
        <ul>
          <li>The seller will prepare and package your item</li>
          <li>You'll receive a shipping confirmation email with tracking details</li>
          <li>Your order will be marked as completed once delivered</li>
        </ul>
      </div>
      <div class="footer">
        <p>&copy; 2026 Plenty Value. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>